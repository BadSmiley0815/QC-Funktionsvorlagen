<?xml version="1.0" encoding="utf-8"?>
<!--
  Funktionsvorlage: Klimaanlage Zennio KLIC-DI v2 / Daikin
  Datei: template.xml
  Aufbau gemaess Gira Template SDK V1.0

  Panel 1 (links): Toggle Ein/Aus mit Modus-Statustext
  Panel 2 (rechts): Soll/Ist-Temperatur (Heizungs-Layout) - oeffnet PopUp
-->
<template>

  <!-- ============================================================
       PANEL 1: Ein/Aus mit Modus-Statustext
       ============================================================ -->
  <panel pos="1" click="1" layout="pan_togglebtn">

    <!-- Hintergrund: gruen wenn an, grau wenn aus -->
    <icon_dyn layout="pan_togglebtn.full" ico="tpl_btn_blue_bg">
      <content case_slot="onoff_status">
        <case from="1" from_type="2" to="1" to_type="2" ico="tpl_btn_green_bg" />
        <case from="0" from_type="2" to="0" to_type="2" ico="tpl_btn_blue_bg" />
      </content>
    </icon_dyn>

    <!-- Text "EIN" + aktueller Modus, sichtbar wenn an -->
    <text_dyn cell="text_on" default="EIN">
      <content case_slot="mode_status">
        <case from="0"  from_type="2" to="0"  to_type="2" value="AUTO" />
        <case from="1"  from_type="2" to="1"  to_type="2" value="HEIZEN" />
        <case from="3"  from_type="2" to="3"  to_type="2" value="KUEHLEN" />
        <case from="9"  from_type="2" to="9"  to_type="2" value="LUEFTEN" />
        <case from="14" from_type="2" to="14" to_type="2" value="TROCKNEN" />
      </content>
      <visible slot="onoff_status" from="1" from_type="2" to="1" to_type="2" />
    </text_dyn>

    <!-- Text "AUS" sichtbar wenn ausgeschaltet -->
    <text_dyn cell="text_off" value="AUS">
      <visible slot="onoff_status" from="0" from_type="2" to="0" to_type="2" />
    </text_dyn>

    <!-- Aktion: Ein/Aus toggeln -->
    <action_down click="1" type="toggle" slot="onoff_set" value="1" />

  </panel>

  <!-- ============================================================
       PANEL 2: Soll-/Ist-Temperatur, oeffnet PopUp bei Klick
       Verwendet das Heizungs-Layout (pan_heat)
       ============================================================ -->
  <panel pos="2" click="1" layout="pan_heat">

    <!-- Thermometer-Icon, faerbt sich rot bei Heizen, blau bei Kuehlen -->
    <icon_dyn cell="icon" ico="tpl_heat_valico1">
      <content case_slot="mode_status">
        <case from="1" from_type="2" to="1" to_type="2" ico="tpl_heat_valico1" />
        <case from="3" from_type="2" to="3" to_type="2" ico="tpl_heat_valico2" />
      </content>
    </icon_dyn>

    <!-- Soll-Beschriftung -->
    <text cell="txt1" value="Soll" color="#E6E6E6" />

    <!-- Soll-Temperatur (dynamisch aus KO) -->
    <text_dyn cell="txt2" len="2" prec="1" unit="°">
      <content value_slot="soll_temp_status" />
    </text_dyn>

    <!-- Ist-Beschriftung -->
    <text cell="txt3" value="Ist" />

    <!-- Ist-Temperatur (dynamisch aus KO, ohne Farbumschaltung -
         Stoerung wird im PopUp ueber rote LED angezeigt) -->
    <text_dyn cell="txt4" len="2" prec="1" unit="°">
      <content value_slot="ist_temp" />
    </text_dyn>

    <!-- Klick oeffnet das Bedien-PopUp -->
    <action_down click="1" type="popup" id="1" />

  </panel>


  <!-- ============================================================
       POPUP 1: Vollstaendige Bedienung
       Grid-Aufteilung (6 Spalten 1-6, 8 Zeilen A-H):
         Zeile A: Titel
         Zeile B: Solltemperatur - Minus / Edit / Plus
         Zeile C: Modus-Buttons (AUTO / HEIZEN / KUEHLEN)
         Zeile D: Modus-Buttons (LUEFTEN / TROCKNEN)
         Zeile E: Luefter-Buttons (Auto / Niedrig / Mittel / Hoch)
         Zeile F: Lamellen Toggle
         Zeile G: Stoerungsanzeige (sichtbar nur bei aktivem Fehler)
         Zeile H: OK-Button
       ============================================================ -->
  <popup id="1" layout="pop_green.form" ico="tpl_pop_bg">

    <!-- Titel -->
    <text layout="pop_green.caption" value="Klimaanlage" />

    <!-- ============================================================
         Grid-Notation gemaess SDK Seite 20:
           Buchstabe = ZEILE (A oben, H unten, 8 Zeilen)
           Zahl      = SPALTE (1 links, 6 rechts, 6 Spalten)
         Buttons (pop_btn_*) sind je 2 Zeilen hoch.
         ============================================================ -->

    <!-- ===== ZEILE A-B: EIN/AUS + SOLLTEMPERATUR =====
         Spalte 1 = Ein/Aus, Spalte 2 = Minus, Spalten 3-5 = Edit, Spalte 6 = Plus
         Ein/Aus: Toggle, Status ueber selected_slot=onoff_status -->
    <button layout="pop_btn_1" grid="grid1.A1-B1" type="2" icon="tpl_ico_state_on_2"
            selected_slot="onoff_status" selected_from="1" selected_to="1">
      <action_down type="toggle" slot="onoff_set" value="1" />
    </button>

    <button layout="pop_btn_1" grid="grid1.A2-B2" type="2" icon="tpl_pop_ico_minus">
      <action_down type="step_down" border="$par_temp_min"
                   slot="soll_temp_set" value="$par_temp_skip" def_value="0.5" />
    </button>

    <edit layout="edit_3" grid="grid1.A3-B5" type="2"
          title="Solltemperatur" slot="soll_temp_set"
          len="2" prec="1" unit="°C"
          min="$par_temp_min" max="$par_temp_max"
          info="Soll" modify="true" />

    <button layout="pop_btn_1" grid="grid1.A6-B6" type="2" icon="tpl_pop_ico_plus">
      <action_down type="step_up" border="$par_temp_max"
                   slot="soll_temp_set" value="$par_temp_skip" def_value="0.5" />
    </button>

    <!-- ===== ZEILEN C-D: BETRIEBSMODUS (Reihe 1: 3 Buttons) =====
         pop_btn_2 ist 2 Spalten breit -> 3x2 = 6 Spalten
         Status-Hervorhebung ueber selected_slot + selected_from/to.
         WICHTIG: kein def_value setzen (verursacht falsche Sendewerte). -->
    <button layout="pop_btn_2" grid="grid1.C1-D2" type="2" icon="tpl_ico_state_automatic_on"
            selected_slot="mode_status" selected_from="0" selected_to="0">
      <action_down type="set" slot="mode_set" value="0" />
    </button>

    <button layout="pop_btn_2" grid="grid1.C3-D4" type="2" icon="tpl_heat_valico1"
            selected_slot="mode_status" selected_from="1" selected_to="1">
      <action_down type="set" slot="mode_set" value="1" />
    </button>

    <button layout="pop_btn_2" grid="grid1.C5-D6" type="2" icon="tpl_heat_valico2"
            selected_slot="mode_status" selected_from="3" selected_to="3">
      <action_down type="set" slot="mode_set" value="3" />
    </button>

    <!-- ===== ZEILEN E-F: BETRIEBSMODUS (Reihe 2: 2 Buttons) =====
         Lueften und Trocknen, je 3 Spalten breit (pop_btn_3) -->
    <button layout="pop_btn_3" grid="grid1.E1-F3" type="2" icon="tpl_ico_vm_intense_ventilation_init"
            selected_slot="mode_status" selected_from="9" selected_to="9">
      <action_down type="set" slot="mode_set" value="9" />
    </button>

    <button layout="pop_btn_3" grid="grid1.E4-F6" type="2" icon="tpl_ico_warmwater_mode_reduced"
            selected_slot="mode_status" selected_from="14" selected_to="14">
      <action_down type="set" slot="mode_set" value="14" />
    </button>

    <!-- ===== ZEILEN G-H: LUEFTERSTUFE (2 Buttons mit Icons) + OK =====
         Buttons sind je 1 Spalte breit (pop_btn_1) - kompaktere Darstellung,
         dazwischen jeweils 1 Spalte Abstand. -->
    <button layout="pop_btn_1" grid="grid1.G1-H1" type="2" icon="tpl_ico_fan_1"
            selected_slot="fan_status" selected_from="1" selected_to="50">
      <action_down type="set" slot="fan_set" value="50" />
    </button>

    <button layout="pop_btn_1" grid="grid1.G2-H2" type="2" icon="tpl_ico_fan_2"
            selected_slot="fan_status" selected_from="51" selected_to="100">
      <action_down type="set" slot="fan_set" value="100" />
    </button>

    <!-- Filter-Reset: zeigt Filter-Status, sendet 1 auf filter_reset bei Klick. -->
    <button layout="pop_btn_1" grid="grid1.G4-H4" type="2" icon="tpl_ico_warn_yellow"
            selected_slot="filter_status" selected_from="1" selected_to="1">
      <action_down type="set" slot="filter_reset" value="1" />
    </button>

    <!-- Stoerungs-Icon: nur sichtbar wenn error_active=1.
         icon_dyn als Pseudo-Button (kein klickbarer Button, nur Anzeige). -->
    <!-- Stoerungs-Icon: dynamischer Wechsel des Icons je nach error_active.
         Bei 0 = unsichtbares Platzhalter-Icon, bei 1 = Stoerungs-Icon -->
    <icon_dyn grid="grid1.G5-H5" ico="">
      <content case_slot="error_active">
        <case from="1" from_type="2" to="1" to_type="2" ico="tpl_ico_error_init" />
        <case from="0" from_type="2" to="0" to_type="2" ico="" />
      </content>
    </icon_dyn>

    <button layout="pop_btn_ok" grid="grid1.G6-H6" type="1" text="OK">
      <action_up type="close" />
    </button>

    <!-- ===== FEHLERANZEIGE =====
         Fehler-Praefix + 14-Byte-Code aus error_code, rot,
         nur sichtbar wenn error_active=1.
         "Fehler {0}" als Format-String setzt das Wort vor den Wert. -->
    <text_dyn layout="pop_green.caption" align="2" color="#FF3030"
              value="Fehler {0}">
      <content value_slot="error_code" />
      <visible slot="error_active" from="1" from_type="2" to="1" to_type="2" />
    </text_dyn>

  </popup>

</template>
