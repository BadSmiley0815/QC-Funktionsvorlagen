<?xml version="1.0" encoding="utf-8"?>
<!-- Funktionsvorlage 99-4 Wetterstation (ID vorläufig, Entwickler-ID bei Gira angefragt) -->
<template has_timer="false" function_key="" folder="misc">
  <slots>
    <slot id="slot_temp" text="#99-4_slot_temp" help="#99-4_slot_temp_hlp" type="KO_NUM" required="true" />
    <slot id="slot_hum" text="#99-4_slot_hum" help="#99-4_slot_hum_hlp" type="KO_NUM" />
    <slot id="slot_wind" text="#99-4_slot_wind" help="#99-4_slot_wind_hlp" type="KO_NUM" />
    <slot id="slot_wind_dir" text="#99-4_slot_wind_dir" help="#99-4_slot_wind_dir_hlp" type="KO_NUM" />
    <slot id="slot_rain" text="#99-4_slot_rain" help="#99-4_slot_rain_hlp" type="KO_NUM" />
    <slot id="slot_lux" text="#99-4_slot_lux" help="#99-4_slot_lux_hlp" type="KO_NUM" />
    <slot id="slot_press" text="#99-4_slot_press" help="#99-4_slot_press_hlp" type="KO_NUM" />
    <parameter id="99-4_par_caption" text="#99-4_par_caption" help="#99-4_par_caption_hlp" type="TEXT" default="#99-4_tplname" />
    <parameter id="99-4_par_wind_unit" text="#99-4_par_wind_unit" help="#99-4_par_wind_unit_hlp" type="TEXT" default="km/h" />
    <parameter id="99-4_par_lux_unit" text="#99-4_par_lux_unit" help="#99-4_par_lux_unit_hlp" type="TEXT" default="lx" />
    <parameter id="99-4_par_press_unit" text="#99-4_par_press_unit" help="#99-4_par_press_unit_hlp" type="TEXT" default="hPa" />
  </slots>
</template>
